{{ 'section-collection-vielfalt.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign want_labels = section.settings.brand_filter_label | downcase | replace: ', ', ',' | replace: ' ,', ',' | split: ','
  assign brand_filter_found = false
  for f in collection.filters
    assign this_label = f.label | downcase | strip
    for want in want_labels
      assign want_label = want | strip
      if this_label == want_label
        assign brand_filter = f
        assign brand_filter_found = true
        break
      endif
    endfor
    if brand_filter_found
      break
    endif
  endfor

  assign heading = section.settings.heading
  if heading contains '[collection]'
    assign heading = heading | replace: '[collection]', collection.title
  endif
-%}

{%- if collection.description != blank or brand_filter_found -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="cattext color-{{ section.settings.color_scheme }} gradient">
    <div class="cattext__inner page-width section-{{ section.id }}-padding">
      {%- if collection.description != blank -%}
        <div>
          {%- if heading != blank -%}
            <h2>{{ heading | escape }}</h2>
          {%- endif -%}
          <div class="cattext__body rte">{{ collection.description }}</div>
          {%- if section.settings.extra_text != blank -%}
            <div class="cattext__body rte">{{ section.settings.extra_text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if brand_filter_found -%}
        <div>
          {%- if section.settings.brand_heading != blank -%}
            <h2>{{ section.settings.brand_heading | escape }}</h2>
          {%- endif -%}
          <ul class="brandlist list-unstyled" role="list">
            {%- for value in brand_filter.values -%}
              {%- if value.count > 0 -%}
                <li><a href="{{ value.url_to_add }}">{{ value.label | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection text",
  "tag": "section",
  "class": "section-cattext",
  "settings": [
    {
      "type": "paragraph",
      "content": "The full collection description, below the products where it does not push them down the page. The brand list is built from the brand filter, so it only ever names brands actually stocked here."
    },
    { "type": "text", "id": "heading", "label": "Heading", "info": "[collection] is replaced with the collection name.", "default": "[collection] bei vielfalt" },
    { "type": "richtext", "id": "extra_text", "label": "Extra paragraph", "info": "Shown on every collection, after the description." },
    { "type": "header", "content": "Brands" },
    { "type": "text", "id": "brand_heading", "label": "Brand list heading", "default": "Marken in dieser Kategorie" },
    { "type": "text", "id": "brand_filter_label", "label": "Filter to build the brand list from", "info": "Comma-separated, first match wins.", "default": "Marke, Brand, Hersteller" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 44 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 44 }
  ]
}
{% endschema %}
