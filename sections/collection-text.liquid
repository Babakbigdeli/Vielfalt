{{ 'section-collection-vielfalt.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign want_labels = section.settings.brand_filter_label | downcase | replace: ', ', ',' | replace: ' ,', ',' | split: ','
  assign brand_filter_found = false
  for f in collection.filters
    assign this_label = f.label | downcase | strip
    for want in want_labels
      assign want_label = want | strip
      if this_label == want_label
        assign brand_filter = f
        assign brand_filter_found = true
        break
      endif
    endfor
    if brand_filter_found
      break
    endif
  endfor

  assign shown = 0
  assign total = 0
  for value in brand_filter.values
    if value.count > 0
      assign total = total | plus: 1
    endif
  endfor

  assign heading = section.settings.heading
  if heading contains '[collection]'
    assign heading = heading | replace: '[collection]', collection.title
  endif
-%}

{%- if brand_filter_found and total > 0 -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="cattext color-{{ section.settings.color_scheme }} gradient">
    <div class="cattext__inner page-width section-{{ section.id }}-padding">
      {%- if heading != blank -%}
        <h2>{{ heading | escape }}</h2>
      {%- endif -%}

      <ul class="brandlist list-unstyled" role="list">
        {%- for value in brand_filter.values -%}
          {%- if value.count > 0 -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- if shown <= section.settings.max_brands -%}
              <li>
                <a href="{{ value.url_to_add }}">
                  {{- value.label | escape -}}
                  <span>{{ value.count }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if total > section.settings.max_brands -%}
        <details class="brandmore">
          <summary>
            {{- section.settings.label_more | replace: '[count]', total -}}
            <span class="brandmore__chev">{{ 'icon-vf-chevron.svg' | inline_asset_content }}</span>
          </summary>
          <ul class="brandlist list-unstyled" role="list">
            {%- assign shown = 0 -%}
            {%- for value in brand_filter.values -%}
              {%- if value.count > 0 -%}
                {%- assign shown = shown | plus: 1 -%}
                {%- if shown > section.settings.max_brands -%}
                  <li>
                    <a href="{{ value.url_to_add }}">
                      {{- value.label | escape -}}
                      <span>{{ value.count }}</span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection brands",
  "tag": "section",
  "class": "section-cattext",
  "settings": [
    {
      "type": "paragraph",
      "content": "The brands stocked in this collection, built from the brand filter, so it only ever names brands that are actually here. Each chip filters the grid."
    },
    { "type": "text", "id": "heading", "label": "Heading", "info": "[collection] is replaced with the collection name.", "default": "Marken in dieser Kategorie" },
    { "type": "text", "id": "brand_filter_label", "label": "Filter to build the list from", "info": "Comma-separated, first match wins.", "default": "Marke, Brand, Hersteller" },
    { "type": "range", "id": "max_brands", "min": 8, "max": 60, "step": 4, "label": "Brands shown before the link", "default": 24 },
    { "type": "text", "id": "label_more", "label": "Show-all link", "info": "[count] is replaced with the number of brands.", "default": "Alle [count] Marken anzeigen" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 44 }
  ]
}
{% endschema %}
