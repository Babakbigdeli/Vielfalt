{{ 'component-card-vielfalt.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign more_url = section.settings.link_url
  assign more_label = section.settings.link_label
  if more_url == blank
    assign auto_coll = product.collections | first
    unless auto_coll
      assign first_rec = recommendations.products | first
      assign auto_coll = first_rec.collections | first
    endunless
    if auto_coll
      assign more_url = auto_coll.url
      if more_label == blank
        assign more_label = section.settings.link_prefix | append: ' ' | append: auto_coll.title
      endif
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    class="vfcards page-width section-{{ section.id }}-padding"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="vfrel__head">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="vfrel__kicker">{{ section.settings.kicker | escape }}</span>
          {%- endif -%}
          <h2 class="vfrel__heading">{{ section.settings.heading | escape }}</h2>
        </div>

        {%- if more_url != blank and more_label != blank -%}
          <a class="vfrel__more" href="{{ more_url }}">
            {{- more_label | escape -}}
            {{ 'icon-vf-chevron.svg' | inline_asset_content }}
          </a>
        {%- endif -%}
      </div>

      <ul class="vfcards__grid" role="list" style="--vf-cols: {{ section.settings.columns_desktop }}">
        {%- for recommendation in recommendations.products -%}
          <li>
            {%- render 'card-vielfalt',
              card_product: recommendation,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              show_secondary: section.settings.show_secondary_image,
              low_threshold: section.settings.low_threshold,
              tax_note: section.settings.tax_note,
              tax_link: section.settings.tax_link,
              label_from: section.settings.label_from,
              label_in_stock: section.settings.label_in_stock,
              label_out_stock: section.settings.label_out_stock,
              label_low: section.settings.label_low,
              label_sold_out: section.settings.label_sold_out,
              stock_suffix: section.settings.stock_suffix,
              badge_prefix: section.settings.badge_prefix,
              lazy: true
            -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </product-recommendations>
</div>

{% schema %}
{
  "name": "Related products (Vielfalt)",
  "tag": "section",
  "class": "section-vfrel",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shopify picks the products. Every line on the card comes from product data — vendor, price, compare-at price and stock — so nothing here needs filling in per product."
    },
    { "type": "text", "id": "kicker", "label": "Kicker above the heading", "default": "Passend dazu" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ähnliche Artikel" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related"
    },
    { "type": "header", "content": "Link beside the heading" },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "Leave empty to build it from the product's own collection." },
    { "type": "text", "id": "link_prefix", "label": "Automatic label prefix", "default": "Alle" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Leave empty to link to the product's own collection." },
    { "type": "header", "content": "Card content" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show the brand", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show the star rating", "info": "Only appears once a reviews app writes the rating metafield. Nothing renders until then.", "default": true },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Swap to the second image on hover", "default": false },
    { "type": "text", "id": "label_from", "label": "Price prefix for a price range", "default": "ab" },
    { "type": "text", "id": "tax_note", "label": "Tax note", "default": "inkl. MwSt. zzgl." },
    { "type": "text", "id": "tax_link", "label": "Tax note link text", "info": "Links to the shipping policy. Leave empty to drop the link.", "default": "Versandkosten" },
    { "type": "header", "content": "Availability line" },
    { "type": "text", "id": "label_in_stock", "label": "In stock", "default": "Auf Lager" },
    { "type": "text", "id": "stock_suffix", "label": "Text after \"in stock\"", "info": "For example a delivery time. Only fill this in once the promise is one you can keep." },
    { "type": "range", "id": "low_threshold", "min": 0, "max": 20, "step": 1, "label": "Low-stock threshold", "default": 5 },
    { "type": "text", "id": "label_low", "label": "Low stock", "info": "[count] is replaced with the quantity left.", "default": "Nur noch [count] verfügbar" },
    { "type": "text", "id": "label_out_stock", "label": "Out of stock", "default": "Derzeit nicht verfügbar" },
    { "type": "text", "id": "label_sold_out", "label": "Sold-out badge", "default": "Ausverkauft" },
    { "type": "text", "id": "badge_prefix", "label": "Custom badge tag prefix", "info": "Tag a product `badge:Bestseller` and the card shows a BESTSELLER badge. No theme edit needed.", "default": "badge:" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ]
}
{% endschema %}
