{{ 'section-category-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #CategoryGrid-{{ section.id }} {
    --category-columns-mobile: {{ section.settings.columns_mobile }};
    --category-columns-desktop: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div
  id="CategoryGrid-{{ section.id }}"
  class="category-grid color-{{ section.settings.color_scheme }} gradient"
>
  <div class="category-grid__wrapper page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank or section.settings.show_view_all -%}
      <div class="category-grid__header">
        {%- if section.settings.title != blank -%}
          <h2
            class="category-grid__title inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          >
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
          <a
            href="{{ section.settings.view_all_link }}"
            class="category-grid__view-all link"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {{ section.settings.view_all_label | default: 'Alle anzeigen' | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="category-grid__list list-unstyled{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      role="list"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      {%- for block in section.blocks -%}
        {%- liquid
          # Everything a card shows is read from the linked collection, so the
          # title, image, link and count can never drift from the real catalogue.
          # The override fields below are only consulted when they are filled in.
          assign coll = block.settings.collection

          assign card_url = block.settings.link
          if card_url == blank and coll != blank
            assign card_url = coll.url
          endif

          assign card_title = block.settings.title
          if card_title == blank and coll != blank
            assign card_title = coll.title
          endif

          assign card_image = block.settings.image
          if card_image == blank and coll != blank
            assign card_image = coll.image
          endif
          if card_image == blank and coll != blank
            assign card_image = coll.products.first.featured_image
          endif

          assign card_count = ''
          if section.settings.show_product_count
            if coll != blank
              assign card_n = coll.all_products_count
              if card_n == 1
                assign card_count = card_n | append: ' ' | append: section.settings.count_label_one
              else
                assign card_count = card_n | append: ' ' | append: section.settings.count_label_other
              endif
            else
              assign card_count = block.settings.product_count
            endif
          endif
        -%}
        <li
          class="category-grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <a
            {% if card_url != blank %}
              href="{{ card_url }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="category-card"
          >
            <div class="category-card__image-wrapper category-card__image-wrapper--{{ section.settings.image_ratio }}">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 800
                  | image_tag:
                    widths: '200, 300, 400, 600, 800',
                    sizes: '(min-width: 990px) calc((var(--page-width, 1200px) - 4rem) / var(--category-columns-desktop, 4)), (min-width: 750px) calc((100vw - 4rem) / 3), calc((100vw - 3rem) / var(--category-columns-mobile, 2))',
                    loading: 'lazy',
                    class: 'category-card__image'
                }}
              {%- else -%}
                <div class="category-card__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>

            <div class="category-card__info">
              {%- if card_title != blank -%}
                <span class="category-card__title">{{ card_title | escape }}</span>
              {%- endif -%}
              {%- if card_count != blank -%}
                <span class="category-card__count">{{ card_count | escape }}</span>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Section heading",
      "default": "Kategorien"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' label",
      "default": "Alle Produkte durchsuchen"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' link"
    },
    {
      "type": "header",
      "content": "Product count"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "info": "Read live from the linked collection, so it cannot go out of date.",
      "default": true
    },
    {
      "type": "text",
      "id": "count_label_one",
      "label": "Count label (singular)",
      "default": "Produkt"
    },
    {
      "type": "text",
      "id": "count_label_other",
      "label": "Count label (plural)",
      "default": "Produkte"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Title, image, link and product count are all read from this collection."
        },
        {
          "type": "header",
          "content": "Overrides (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection title."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the collection URL."
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product count text",
          "info": "Used only when no collection is selected. Prefer selecting a collection so the number stays true."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "settings": {
        "title": "Kategorien",
        "show_view_all": true,
        "view_all_label": "Alle Produkte durchsuchen",
        "columns_desktop": "4",
        "columns_mobile": "2",
        "image_ratio": "square"
      },
      "blocks": [
        {
          "type": "category_item"
        },
        {
          "type": "category_item"
        },
        {
          "type": "category_item"
        },
        {
          "type": "category_item"
        },
        {
          "type": "category_item"
        },
        {
          "type": "category_item"
        },
        {
          "type": "category_item"
        }
      ]
    }
  ]
}
{% endschema %}
