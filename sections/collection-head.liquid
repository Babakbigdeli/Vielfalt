{{ 'section-collection-vielfalt.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign dept_handle = ''
  assign lead_product = collection.products.first
  for tag in lead_product.tags
    assign head = tag | slice: 0, 10
    if head == 'abteilung:'
      assign dept_handle = tag | remove_first: 'abteilung:'
      break
    endif
  endfor

  assign is_department = false
  if dept_handle == collection.handle
    assign is_department = true
  else
    assign dept = collections[dept_handle]
  endif

  assign cat_parent_found = false
  if is_department and section.settings.show_category_links
    assign menu = linklists[section.settings.menu]
    for l in menu.links
      if l.url == collection.url
        assign cat_parent = l
        assign cat_parent_found = true
        break
      endif
    endfor
  endif

  assign lede_html = collection.description
  if section.settings.lede_first_paragraph and collection.description contains '</p>'
    assign lede_parts = collection.description | split: '</p>'
    assign lede_html = lede_parts[0] | append: '</p>'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="cathead color-{{ section.settings.color_scheme }} gradient">
  <div class="cathead__inner page-width section-{{ section.id }}-padding">
    {%- if section.settings.show_kicker and is_department == false -%}
      {%- if dept != blank and dept.handle != blank -%}
        <a class="cathead__kicker" href="{{ dept.url }}">{{ dept.title | escape }}</a>
      {%- elsif section.settings.kicker_fallback != blank -%}
        <span class="cathead__kicker">{{ section.settings.kicker_fallback | escape }}</span>
      {%- endif -%}
    {%- endif -%}

    <div class="cathead__titlerow">
      <h1 class="cathead__title">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_count and collection.all_products_count > 0 -%}
        <span class="cathead__count">
          {{- collection.all_products_count }} {{ section.settings.count_label | escape -}}
        </span>
      {%- endif -%}
    </div>

    {%- if section.settings.show_description and lede_html != blank -%}
      <div class="cathead__lede rte">{{ lede_html }}</div>
    {%- endif -%}

    {%- if cat_parent_found and cat_parent.links.size > 0 -%}
      <nav class="catpills" aria-label="{{ section.settings.links_aria | escape }}">
        {%- for child in cat_parent.links -%}
          <a class="catpill" href="{{ child.url }}">
            {{- child.title | escape -}}
            {%- if child.object.products_count > 0 -%}
              <span>{{ child.object.products_count }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection head",
  "tag": "section",
  "class": "section-cathead",
  "settings": [
    {
      "type": "paragraph",
      "content": "Kicker, title, product count and intro. On a department page it also links down to that department's categories, taken from the main menu. Nothing needs filling in per collection."
    },
    { "type": "checkbox", "id": "show_kicker", "label": "Show the department above the title", "default": true },
    { "type": "text", "id": "kicker_fallback", "label": "Kicker when no department is found" },
    { "type": "checkbox", "id": "show_count", "label": "Show the product count", "default": true },
    { "type": "text", "id": "count_label", "label": "Word after the count", "default": "Artikel" },
    { "type": "checkbox", "id": "show_description", "label": "Show the collection description", "default": true },
    {
      "type": "checkbox",
      "id": "lede_first_paragraph",
      "label": "Only the first paragraph",
      "info": "Off shows the whole description, which is the only place it appears.",
      "default": false
    },
    { "type": "header", "content": "Category links" },
    {
      "type": "checkbox",
      "id": "show_category_links",
      "label": "Link to the categories on a department page",
      "info": "Only renders on a department page, and only for categories that have a collection. Category pages show nothing here \u2014 the Unterkategorie filter already does that job.",
      "default": true
    },
    { "type": "link_list", "id": "menu", "label": "Menu the categories come from", "default": "main-menu" },
    { "type": "text", "id": "links_aria", "label": "Accessible label for the link row", "default": "Kategorien" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 32 }
  ]
}
{% endschema %}
