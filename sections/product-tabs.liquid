{{ 'section-product-tabs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign unter = product.metafields.custom.unterkategorie.value

  assign spec_labels = ''
  assign spec_values = ''

  if product.vendor != blank
    assign spec_labels = spec_labels | append: section.settings.label_brand | append: '|'
    assign spec_values = spec_values | append: product.vendor | append: '|'
  endif
  if unter != blank
    assign spec_labels = spec_labels | append: section.settings.label_category | append: '|'
    assign spec_values = spec_values | append: unter | append: '|'
  endif
  if v.sku != blank
    assign spec_labels = spec_labels | append: section.settings.label_sku | append: '|'
    assign spec_values = spec_values | append: v.sku | append: '|'
  endif
  if v.barcode != blank
    assign spec_labels = spec_labels | append: section.settings.label_ean | append: '|'
    assign spec_values = spec_values | append: v.barcode | append: '|'
  endif
  if v.weight > 0
    assign weight_text = v.weight | weight_with_unit: v.weight_unit
    assign spec_labels = spec_labels | append: section.settings.label_weight | append: '|'
    assign spec_values = spec_values | append: weight_text | append: '|'
  endif
  if product.type != blank
    assign spec_labels = spec_labels | append: section.settings.label_type | append: '|'
    assign spec_values = spec_values | append: product.type | append: '|'
  endif

  assign labels = spec_labels | split: '|'
  assign values = spec_values | split: '|'

  assign intro_html = product.description
  assign spec_blob = ''
  if product.description contains '<p>Technische Daten'
    assign desc_parts = product.description | split: '<p>Technische Daten'
    assign intro_html = desc_parts[0]
    assign spec_blob = desc_parts[1]
  endif

  assign ex_raw = section.settings.features_exclude | downcase | replace: ', ', ',' | replace: ' ,', ','
  assign ex_blob = ',' | append: ex_raw | append: ','

  assign strip_blob = ',' | append: spec_labels | downcase | replace: '|', ',' | append: ','

  assign feat_list = ''
  assign tech_labels = ''
  assign tech_values = ''
  assign glance_labels = ''
  assign glance_values = ''
  assign glance_n = 0

  if spec_blob != blank
    assign spec_lines = spec_blob | strip_html | split: '•'
    for line in spec_lines
      assign entry = line | strip
      if entry contains ':'
        assign row_label = entry | split: ':' | first | strip
        assign row_value = entry | remove_first: row_label | remove_first: ':' | strip
        if row_label != blank and row_value != blank
          assign row_flag = row_value | downcase
          assign ex_key = ',' | append: row_label | downcase | append: ','

          assign is_feat = false
          if row_flag == 'ja'
            unless ex_blob contains ex_key
              assign is_feat = true
            endunless
          endif

          if is_feat
            assign feat_list = feat_list | append: row_label | append: '|'
          endif

          unless is_feat and section.settings.group_feature_rows
            assign tech_labels = tech_labels | append: row_label | append: '|'
            assign tech_values = tech_values | append: row_value | append: '|'
          endunless

          if glance_n < 4 and row_flag != 'ja' and row_flag != 'nein'
            unless strip_blob contains ex_key
              assign glance_labels = glance_labels | append: row_label | append: '|'
              assign glance_values = glance_values | append: row_value | append: '|'
              assign glance_n = glance_n | plus: 1
            endunless
          endif
        endif
      endif
    endfor
  endif

  assign features = feat_list | split: '|'
  assign tech_l = tech_labels | split: '|'
  assign tech_v = tech_values | split: '|'
  assign glance_l = glance_labels | split: '|'
  assign glance_v = glance_values | split: '|'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="product-tabs color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.show_keyspec and labels.size > 0 -%}
      <dl class="keyspec">
        {%- for label in labels -%}
          <div class="keyspec__cell">
            <dt>{{ label }}</dt>
            <dd>{{ values[forloop.index0] }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}

    <product-tabs class="tabs">
      <div class="tabs__list" role="tablist">
        {%- if product.description != blank -%}
          <button
            class="tabs__tab"
            type="button"
            role="tab"
            id="Tab-desc-{{ section.id }}"
            aria-controls="Panel-desc-{{ section.id }}"
            aria-selected="true"
          >
            {{- section.settings.label_description | escape -}}
          </button>
        {%- endif -%}

        {%- if labels.size > 0 -%}
          <button
            class="tabs__tab"
            type="button"
            role="tab"
            id="Tab-specs-{{ section.id }}"
            aria-controls="Panel-specs-{{ section.id }}"
            aria-selected="{% if product.description == blank %}true{% else %}false{% endif %}"
          >
            {{- section.settings.label_specs | escape -}}
          </button>
        {%- endif -%}

        {%- for block in section.blocks -%}
          <button
            class="tabs__tab"
            type="button"
            role="tab"
            id="Tab-{{ block.id }}"
            aria-controls="Panel-{{ block.id }}"
            aria-selected="false"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.heading | escape -}}
          </button>
        {%- endfor -%}
      </div>

      {%- if product.description != blank -%}
        <div
          class="tabs__panel tabs__panel--open"
          role="tabpanel"
          id="Panel-desc-{{ section.id }}"
          aria-labelledby="Tab-desc-{{ section.id }}"
        >
          <div class="tabs__grid">
            <div class="tabs__proseblock">
              <div class="rte tabs__prose">{{ intro_html }}</div>

              {%- if features.size > 0 -%}
                <div class="tabs__features">
                  <h3>{{ section.settings.label_features | escape }}</h3>
                  <ul class="tabs__featurelist" role="list">
                    {%- for feature in features -%}
                      <li>
                        <span class="tabs__tick">{{ 'icon-vf-check.svg' | inline_asset_content }}</span>
                        <span>{{ feature }}</span>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>

            <aside class="tabs__aside">
              {%- if section.settings.callout_body != blank -%}
                <div class="tabs__callout">
                  {%- if section.settings.callout_heading != blank -%}
                    <b>{{ section.settings.callout_heading | escape }}</b>
                  {%- endif -%}
                  {{ section.settings.callout_body }}
                </div>
              {%- endif -%}

              {%- if glance_l.size > 0 -%}
                <table class="spectable">
                  <caption>{{ section.settings.label_glance | escape }}</caption>
                  <tbody>
                    {%- for label in glance_l -%}
                      <tr>
                        <th scope="row">{{ label }}</th>
                        <td>{{ glance_v[forloop.index0] }}</td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>

                {%- if section.settings.label_more != blank -%}
                  <a class="tabs__morelink" href="#Panel-specs-{{ section.id }}" data-tab-target="Tab-specs-{{ section.id }}">
                    {{- section.settings.label_more | escape -}}
                    <span class="tabs__chev">{{ 'icon-vf-chevron.svg' | inline_asset_content }}</span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            </aside>
          </div>
        </div>
      {%- endif -%}

      {%- if labels.size > 0 -%}
        <div
          class="tabs__panel{% if product.description == blank %} tabs__panel--open{% endif %}"
          role="tabpanel"
          id="Panel-specs-{{ section.id }}"
          aria-labelledby="Tab-specs-{{ section.id }}"
        >
          <div class="tabs__grid">
            <table class="spectable">
            <caption>{{ section.settings.label_specs | escape }}</caption>
            <tbody>
              {%- if labels.size > 0 -%}
                <tr><th class="spectable__group" colspan="2">{{ section.settings.group_general | escape }}</th></tr>
                {%- for label in labels -%}
                  <tr>
                    <th scope="row">{{ label }}</th>
                    <td>{{ values[forloop.index0] }}</td>
                  </tr>
                {%- endfor -%}
              {%- endif -%}

              {%- if tech_l.size > 0 -%}
                <tr><th class="spectable__group" colspan="2">{{ section.settings.group_technical | escape }}</th></tr>
                {%- for label in tech_l -%}
                  <tr>
                    <th scope="row">{{ label }}</th>
                    <td>{{ tech_v[forloop.index0] }}</td>
                  </tr>
                {%- endfor -%}
              {%- endif -%}

              {%- if features.size > 0 and section.settings.group_feature_rows -%}
                <tr><th class="spectable__group" colspan="2">{{ section.settings.group_features | escape }}</th></tr>
                {%- for feature in features -%}
                  <tr>
                    <th scope="row">{{ feature }}</th>
                    <td>Ja</td>
                  </tr>
                {%- endfor -%}
              {%- endif -%}
              </tbody>
            </table>
          </div>
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div
          class="tabs__panel"
          role="tabpanel"
          id="Panel-{{ block.id }}"
          aria-labelledby="Tab-{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <div class="tabs__grid">
            <div class="rte tabs__prose">{{ block.settings.content }}</div>
          </div>
        </div>
      {%- endfor -%}
    </product-tabs>
  </div>
</div>

{% javascript %}
  class ProductTabs extends HTMLElement {
    connectedCallback() {
      this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
      this.querySelectorAll('[data-tab-target]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.getElementById(link.getAttribute('data-tab-target'));
          if (!target) return;
          event.preventDefault();
          this.select(target);
          this.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
      this.tabs.forEach((tab) => {
        tab.addEventListener('click', () => this.select(tab));
        tab.addEventListener('keydown', (event) => this.onKeydown(event, tab));
      });
      this.setTabindexes();
    }

    setTabindexes() {
      this.tabs.forEach((tab) => {
        tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1;
      });
    }

    select(tab) {
      this.tabs.forEach((other) => {
        const open = other === tab;
        other.setAttribute('aria-selected', open ? 'true' : 'false');
        const panel = document.getElementById(other.getAttribute('aria-controls'));
        if (panel) panel.classList.toggle('tabs__panel--open', open);
      });
      this.setTabindexes();
      tab.focus();
    }

    onKeydown(event, tab) {
      const keys = { ArrowRight: 1, ArrowLeft: -1 };
      if (!(event.key in keys)) return;
      event.preventDefault();
      const next = this.tabs[(this.tabs.indexOf(tab) + keys[event.key] + this.tabs.length) % this.tabs.length];
      this.select(next);
    }
  }

  customElements.define('product-tabs', ProductTabs);
{% endjavascript %}

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "class": "section-product-tabs",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Everything on this section is generated from data you already have: the key-spec strip from vendor, category, SKU, barcode, weight and type, and the Merkmale list, the 'Auf einen Blick' table and the technical table from the supplier spec sheet in the product description. No per-product data entry. Add extra tabs below for content that is the same on every product, such as shipping and returns."
    },
    { "type": "checkbox", "id": "show_keyspec", "label": "Show the key-spec strip", "default": true },
    { "type": "text", "id": "label_description", "label": "Description tab label", "default": "Beschreibung" },
    { "type": "text", "id": "label_specs", "label": "Technical data tab label", "default": "Technische Daten" },
    { "type": "header", "content": "Spec row labels" },
    { "type": "text", "id": "label_brand", "label": "Brand", "default": "Marke" },
    { "type": "text", "id": "label_category", "label": "Category", "default": "Kategorie" },
    { "type": "text", "id": "label_sku", "label": "Article number", "default": "Art.-Nr." },
    { "type": "text", "id": "label_ean", "label": "Barcode", "default": "EAN" },
    { "type": "text", "id": "label_weight", "label": "Weight", "default": "Gewicht" },
    { "type": "text", "id": "label_type", "label": "Product type", "default": "Produktart" },
    { "type": "text", "id": "group_general", "label": "General group heading", "default": "Allgemein" },
    { "type": "text", "id": "group_technical", "label": "Technical group heading", "default": "Technische Daten" },
    { "type": "text", "id": "group_features", "label": "Feature group heading", "default": "Ausstattung" },
    { "type": "checkbox", "id": "group_feature_rows", "label": "Group the Ja/Nein feature rows at the end of the table", "info": "On: rows whose value is simply \"Ja\" are collected under the feature heading instead of sitting between the measurements. Nothing is removed either way.", "default": true },
    { "type": "header", "content": "Beside the description" },
    { "type": "text", "id": "label_glance", "label": "Heading of the small table beside the description", "default": "Auf einen Blick" },
    { "type": "text", "id": "label_more", "label": "Link under that table", "default": "Alle technischen Daten ansehen" },
    { "type": "header", "content": "Merkmale list" },
    { "type": "text", "id": "label_features", "label": "Feature list heading", "default": "Merkmale" },
    { "type": "textarea", "id": "features_exclude", "label": "Never show these as features", "info": "Comma-separated spec labels. A row whose value is \"Ja\" but whose label reads badly on its own belongs here \u2014 it stays in the technical table.", "default": "Unterst\u00fctzte Linux-Betriebssysteme, Unterst\u00fctzte Mac-Betriebssysteme, Unterst\u00fctzte Windows-Betriebssysteme, Unterst\u00fctzte mobile Betriebssysteme" },
    { "type": "header", "content": "Callout beside the description" },
    { "type": "text", "id": "callout_heading", "label": "Callout heading" },
    { "type": "richtext", "id": "callout_body", "label": "Callout text" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 44 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 32 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Tab label", "default": "Versand & Rückgabe" },
        { "type": "richtext", "id": "content", "label": "Tab content" }
      ]
    }
  ],
  "presets": [
    { "name": "Product tabs" }
  ]
}
{% endschema %}
