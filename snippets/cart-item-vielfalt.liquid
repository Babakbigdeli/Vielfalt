{%- liquid
  assign v = item.variant
  assign qty_max_set = false
  if v.quantity_rule.max != null
    assign qty_max_set = true
  endif

  assign stock_state = 'out'
  if v.available
    assign stock_state = 'in'
    if low_threshold > 0 and v.inventory_management != blank and v.inventory_policy == 'deny'
      if v.inventory_quantity > 0 and v.inventory_quantity <= low_threshold
        assign stock_state = 'low'
      endif
    endif
  endif

  assign can_update_quantity = item.instructions.can_update_quantity | default: true
  assign can_remove = item.instructions.can_remove | default: true

  assign has_options = false
  if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != null
    assign has_options = true
  endif

  assign each_money = item.final_price | money
  assign each_text = label_each | default: '[price] pro Stück' | replace: '[price]', each_money
-%}

<li class="cart-item vfitem{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}" id="CartItem-{{ line }}">
  <div class="vfitem__grid">
    <a class="vfitem__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
      {%- if item.image -%}
        <img
          src="{{ item.image | image_url: width: 240 }}"
          alt="{{ item.image.alt | escape }}"
          loading="lazy"
          width="120"
          height="{{ 120 | divided_by: item.image.aspect_ratio | ceil }}"
        >
      {%- endif -%}
    </a>

    <div class="vfitem__body">
      {%- if show_vendor and item.product.vendor != blank -%}
        <span class="vfitem__vendor">{{ item.product.vendor }}</span>
      {%- endif -%}

      <a href="{{ item.url }}" class="cart-item__name vfitem__name break">{{ item.product.title | escape }}</a>

      {%- if show_sku and v.sku != blank -%}
        <span class="vfitem__sku">{{ sku_prefix }}{{ v.sku }}</span>
      {%- endif -%}

      {%- if has_options -%}
        <dl class="vfitem__options">
          {%- if item.product.has_only_default_variant == false -%}
            {%- for option in item.options_with_values -%}
              <div>
                <dt>{{ option.name }}:</dt>
                <dd>{{ option.value }}</dd>
              </div>
            {%- endfor -%}
          {%- endif -%}

          {%- for property in item.properties -%}
            {%- assign property_first_char = property.first | slice: 0 -%}
            {%- if property.last != blank and property_first_char != '_' -%}
              <div>
                <dt>{{ property.first }}:</dt>
                <dd>
                  {%- if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}" class="link" target="_blank">
                      {{- property.last | split: '/' | last -}}
                    </a>
                  {%- else -%}
                    {{- property.last -}}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </dl>

        {%- if item.selling_plan_allocation != null -%}
          <p class="vfitem__plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if item.line_level_discount_allocations.size > 0 -%}
        <ul class="vfitem__discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
          {%- for discount in item.line_level_discount_allocations -%}
            <li>
              {{- 'icon-discount.svg' | inline_asset_content -}}
              {{ discount.discount_application.title | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if show_stock -%}
        <span class="vfitem__stock">
          {%- case stock_state -%}
            {%- when 'low' -%}
              <i class="vfitem__dot vfitem__dot--low"></i>
              {{- label_low | default: 'Nur noch [count] verfügbar' | replace: '[count]', v.inventory_quantity -}}
            {%- when 'in' -%}
              <i class="vfitem__dot"></i>
              {{- label_in_stock | default: 'Auf Lager' -}}
            {%- else -%}
              <i class="vfitem__dot vfitem__dot--out"></i>
              {{- label_out_stock | default: 'Derzeit nicht verfügbar' -}}
          {%- endcase -%}
        </span>
      {%- endif -%}
    </div>

    <div class="vfitem__qty">
      <label class="visually-hidden" for="Quantity-{{ line }}">
        {{ 'products.product.quantity.label' | t }}
      </label>

      <quantity-input class="quantity vfqty">
        <button
          class="quantity__button"
          name="minus"
          type="button"
          {% if can_update_quantity == false %}
            disabled
          {% endif %}
        >
          <span class="visually-hidden">
            {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-minus.svg' | inline_asset_content -}}
          </span>
        </button>
        <input
          class="quantity__input"
          data-quantity-variant-id="{{ v.id }}"
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          {% # theme-check-disable %}
          data-cart-quantity="{{ cart | item_count_for_variant: v.id }}"
          min="0"
          data-min="{{ v.quantity_rule.min }}"
          {% if qty_max_set %}
            max="{{ v.quantity_rule.max }}"
          {% endif %}
          step="{{ v.quantity_rule.increment }}"
          {% # theme-check-enable %}
          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
          id="Quantity-{{ line }}"
          data-index="{{ line }}"
          {% if can_update_quantity == false %}
            disabled
          {% endif %}
        >
        <button
          class="quantity__button"
          name="plus"
          type="button"
          {% if can_update_quantity == false %}
            disabled
          {% endif %}
        >
          <span class="visually-hidden">
            {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </button>
      </quantity-input>

      <cart-remove-button
        class="vfitem__remove{% if can_remove == false %} hidden{% endif %}"
        id="Remove-{{ line }}"
        data-index="{{ line }}"
      >
        <a
          href="{{ item.url_to_remove }}"
          aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
        >
          {{- 'icon-remove.svg' | inline_asset_content -}}
          {{ label_remove | default: 'Entfernen' }}
        </a>
      </cart-remove-button>
    </div>

    <div class="vfitem__price">
      {%- if item.original_line_price != item.final_line_price -%}
        <b>{{ item.final_line_price | money }}</b>
        <s>{{ item.original_line_price | money }}</s>
      {%- else -%}
        <b>{{ item.original_line_price | money }}</b>
      {%- endif -%}

      {%- if item.quantity > 1 -%}
        <span>{{ each_text }}</span>
      {%- endif -%}

      {%- if v.available and item.unit_price_measurement -%}
        {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
      {%- endif -%}
    </div>
  </div>

  <div class="cart-item__error vfitem__error" id="Line-item-error-{{ line }}" role="alert">
    <small class="cart-item__error-text"></small>
    <span class="vfitem__error-ico">{{ 'icon-error.svg' | inline_asset_content }}</span>
  </div>

  {%- render 'loading-spinner' -%}
</li>
